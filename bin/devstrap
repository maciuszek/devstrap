#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  devstrap --container claude [--shell NAME] [--project-dir DIR]
  devstrap --shell NAME [--project-dir DIR]
  devstrap --help

Options:
  --container NAME   Install a dev-container template (currently: claude)
  --shell NAME       Install a dev-shell template (nix, bash)
  --project-dir DIR  Target project directory (default: current directory)
  -h, --help         Show this help

Safety:
  Requested components are validated before anything is written.
  devstrap refuses to overwrite or merge with existing managed paths/files.
USAGE
}

die() { printf 'devstrap: %s\n' "$*" >&2; exit 1; }

CONTAINER_TEMPLATE=""
SHELL_TEMPLATE=""
PROJECT_DIR="."

while (($#)); do
  case "$1" in
    --container)
      (($# >= 2)) || die "--container requires a value"
      CONTAINER_TEMPLATE=$2; shift 2 ;;
    --shell)
      (($# >= 2)) || die "--shell requires a value"
      SHELL_TEMPLATE=$2; shift 2 ;;
    --project-dir)
      (($# >= 2)) || die "--project-dir requires a value"
      PROJECT_DIR=$2; shift 2 ;;
    -h|--help)
      usage; exit 0 ;;
    *)
      die "unknown argument: $1 (try --help)" ;;
  esac
done

[[ -n "$CONTAINER_TEMPLATE" || -n "$SHELL_TEMPLATE" ]] || { usage >&2; exit 2; }
[[ -d "$PROJECT_DIR" ]] || die "project directory does not exist: $PROJECT_DIR"
PROJECT_DIR=$(cd "$PROJECT_DIR" && pwd -P)
PROJECT_NAME=$(basename "$PROJECT_DIR")

# Resolve symlinks so ~/bin/devstrap can point at either a checkout or a copied
# runtime, with templates read from alongside whichever one it resolves to.
SOURCE=${BASH_SOURCE[0]}
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR=$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)
  SOURCE=$(readlink -- "$SOURCE")
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
SCRIPT_DIR=$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)
ROOT_DIR=$(cd "$SCRIPT_DIR/.." && pwd -P)
TEMPLATES="$ROOT_DIR/templates"
[[ -d "$TEMPLATES" ]] || die "templates directory not found beside devstrap: $TEMPLATES"

planned=()
conflicts=()
CONTAINER_DIR=""
SHELL_FLAKE=""
SAFETY_BOUNDARIES=""

path_exists() {
  # -L also catches broken symlinks, which must not be silently replaced.
  [[ -e "$1" || -L "$1" ]]
}

if [[ -n "$CONTAINER_TEMPLATE" ]]; then
  case "$CONTAINER_TEMPLATE" in
    claude) ;;
    *) die "unknown container template: $CONTAINER_TEMPLATE" ;;
  esac

  CONTAINER_DIR="$TEMPLATES/container/$CONTAINER_TEMPLATE"
  for template_file in Dockerfile claude-managed-settings.json devcontainer-lock.json devcontainer.json; do
    [[ -f "$CONTAINER_DIR/$template_file" ]] || \
      die "container template file not found: $CONTAINER_DIR/$template_file"
  done

  if [[ "$CONTAINER_TEMPLATE" == "claude" ]]; then
    SAFETY_BOUNDARIES="$CONTAINER_DIR/claude-md-safety-boundaries.md"
    [[ -f "$SAFETY_BOUNDARIES" ]] || \
      die "Claude safety-boundaries snippet not found: $SAFETY_BOUNDARIES"
  fi

  planned+=(".devcontainer/ (container: $CONTAINER_TEMPLATE)")
  if path_exists "$PROJECT_DIR/.devcontainer"; then
    conflicts+=("dev-container ($CONTAINER_TEMPLATE)|$PROJECT_DIR/.devcontainer")
  fi
fi

if [[ -n "$SHELL_TEMPLATE" ]]; then
  case "$SHELL_TEMPLATE" in
    nix|bash) ;;
    *) die "unknown shell template: $SHELL_TEMPLATE" ;;
  esac

  SHELL_FLAKE="$TEMPLATES/shell/$SHELL_TEMPLATE/flake.nix"
  [[ -f "$SHELL_FLAKE" ]] || die "shell template file not found: $SHELL_FLAKE"

  planned+=("flake.nix (shell: $SHELL_TEMPLATE)")
  if path_exists "$PROJECT_DIR/flake.nix"; then
    conflicts+=("dev-shell ($SHELL_TEMPLATE)|$PROJECT_DIR/flake.nix")
  fi
  if path_exists "$PROJECT_DIR/flake.lock"; then
    conflicts+=("dev-shell ($SHELL_TEMPLATE)|$PROJECT_DIR/flake.lock")
  fi
fi

if ((${#conflicts[@]})); then
  printf 'devstrap: conflicts detected; no files were changed.\n' >&2
  current_component=""
  for conflict in "${conflicts[@]}"; do
    component=${conflict%%|*}
    path=${conflict#*|}
    if [[ "$component" != "$current_component" ]]; then
      printf '  %s:\n' "$component" >&2
      current_component=$component
    fi
    printf '    - %s already exists\n' "$path" >&2
  done
  exit 1
fi

printf 'Project: %s\n' "$PROJECT_DIR"
printf 'Create:\n'
printf '  %s\n' "${planned[@]}"

if [[ -n "$CONTAINER_TEMPLATE" ]]; then
  # Deliberately not `mkdir -p`: this is an atomic exclusive create, and the
  # last guard against writing into an existing .devcontainer if the conflict
  # check above is ever wrong. Adding -p would silently weaken the
  # all-or-nothing guarantee with nothing failing to catch it.
  mkdir "$PROJECT_DIR/.devcontainer"
  cp "$CONTAINER_DIR/Dockerfile" "$PROJECT_DIR/.devcontainer/Dockerfile"
  cp "$CONTAINER_DIR/claude-managed-settings.json" "$PROJECT_DIR/.devcontainer/claude-managed-settings.json"
  cp "$CONTAINER_DIR/devcontainer-lock.json" "$PROJECT_DIR/.devcontainer/devcontainer-lock.json"
  # Escape replacement-sensitive characters for sed.
  PROJECT_NAME_SED=$(printf '%s' "$PROJECT_NAME" | sed 's/[\&|]/\\&/g')
  sed \
    -e "s|__PROJECT_NAME__|$PROJECT_NAME_SED|g" \
    "$CONTAINER_DIR/devcontainer.json" > "$PROJECT_DIR/.devcontainer/devcontainer.json"
fi

if [[ -n "$SHELL_TEMPLATE" ]]; then
  cp "$SHELL_FLAKE" "$PROJECT_DIR/flake.nix"
fi

if [[ -n "$SAFETY_BOUNDARIES" ]]; then
  printf '\nRecommended: review and add the following section to the project CLAUDE.md:\n\n'
  cat "$SAFETY_BOUNDARIES"
  printf '\n'
fi

printf 'devstrap: done\n'
